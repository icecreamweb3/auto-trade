# Local development only. Copy to .env and replace the password.
TIMESCALEDB_IMAGE=timescale/timescaledb:2.30.1-pg16
NATS_IMAGE=nats:2.15.0-alpine
POSTGRES_DB=auto_trade
POSTGRES_USER=auto_trade_admin
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_LOCAL_PASSWORD
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_MAX_LOCKS_PER_TRANSACTION=4096
AUTH_SESSION_DAYS=30
# Set true only when the UI is served through HTTPS.
AUTH_COOKIE_SECURE=false
DEFAULT_ADMIN_USERNAME=Admin
DEFAULT_ADMIN_PASSWORD=Admin@123
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
MONITOR_BIND_IP=127.0.0.1
MONITOR_PORT=8080

ENVIRONMENT=DEV
SERVICE_NAME=auto-trade-api
NODE_ID=local-1
SHARD_ID=0
LOG_LEVEL=INFO
FILE_LOG_ENABLED=false
FILE_LOG_RETENTION_DAYS=14
POSTGRES_HOST=127.0.0.1
NATS_URL=nats://127.0.0.1:4222
BINANCE_USDM_BASE_URL=https://fapi.binance.com
BINANCE_USDM_WEBSOCKET_URL=wss://fstream.binance.com
BINANCE_REQUEST_TIMEOUT_SECONDS=10
BINANCE_MAX_CONCURRENCY=8
BINANCE_REQUEST_ATTEMPTS=3
COLLECTOR_STARTUP_DELAY_SECONDS=5
COLLECTOR_BOUNDARY_DELAY_SECONDS=15
WEBSOCKET_MARK_PUBLISH_CONCURRENCY=32
MONITORING_DATA_SAFETY_DELAY_SECONDS=30
DAILY_RANKING_SCAN_INTERVAL_SECONDS=300
DAILY_RANKING_LOOKBACK_DAYS=90
DAILY_RANKING_MAX_DAYS_PER_CYCLE=7
EMA_INDICATOR_SCAN_INTERVAL_SECONDS=300
EMA_INDICATOR_WRITE_BATCH_SIZE=1000
# A new realtime checkpoint warms from only the latest source bars. Full BTC/ETH
# history is handled by the separate one-shot ema-indicators-history service.
EMA_INDICATOR_BOOTSTRAP_BARS=2880
EMA_HISTORY_CHUNK_DAYS=7
INSTRUMENT_SYNC_UTC_HOUR=16
WEBSOCKET_STREAMS_PER_CONNECTION=100
WEBSOCKET_RECONNECT_MAX_SECONDS=30
WEBSOCKET_RECEIVE_TIMEOUT_SECONDS=60
WEBSOCKET_MESSAGE_QUEUE_SIZE=4096
WEBSOCKET_KLINE_WORKERS_PER_CONNECTION=4
# Full historical repair horizon: 90 days. The service scans it in bounded windows
# while continuing to scan the most recent 24 hours every cycle.
GAP_SCAN_LOOKBACK_HOURS=2160
GAP_SCAN_RECENT_LOOKBACK_HOURS=24
GAP_SCAN_HISTORICAL_WINDOW_HOURS=24
GAP_SCAN_INTERVAL_SECONDS=300
GAP_SCAN_SAFETY_DELAY_SECONDS=60
GAP_SCAN_STATEMENT_TIMEOUT_SECONDS=45
BACKFILL_JOBS_PER_CYCLE=50
BACKFILL_WORKER_COUNT=4
BACKFILL_VERIFY_TIMEOUT_SECONDS=60
BACKFILL_VERIFY_POLL_INTERVAL_SECONDS=1
BACKFILL_STALE_JOB_SECONDS=300
BACKFILL_FAILED_RETRY_LIMIT=3
BACKFILL_REQUEST_INTERVAL_SECONDS=2
BACKFILL_RATE_LIMIT_COOLDOWN_SECONDS=300
PAPER_HISTORY_REQUEST_INTERVAL_SECONDS=0.5

# Telegram @wizzalert ingestion. Create these credentials at my.telegram.org.
# Run the one-shot telegram-auth service once before starting telegram-subscriber.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# TELEGRAM_CHANNEL remains as the single-channel backward-compatible default.
TELEGRAM_CHANNEL=wizzalert
TELEGRAM_CHANNELS=["wizzalert","BWE_OI_Price_monitor"]
# Applied only when a channel has no stored messages. Times must include a timezone.
# Example: {"BWE_OI_Price_monitor":"2026-10-01T00:00:00+08:00"}
TELEGRAM_CHANNEL_BACKFILL_STARTS={}
TELEGRAM_SESSION_PATH=/data/telegram/wizzalert.session
# Prefer an explicit proxy URL. When blank, the subscriber uses ALL_PROXY,
# HTTPS_PROXY, then HTTP_PROXY. Live strategy execution remains off by default.
TELEGRAM_PROXY_URL=
TELEGRAM_RECENT_RESCAN_MESSAGES=200
TELEGRAM_RECONNECT_DELAY_SECONDS=5
TELEGRAM_STRATEGY_TRIGGER_ENABLED=false

# Leave blank when the deployment host can reach Binance directly.
PROXY=
ALL_PROXY=
BINANCE_PROXY_URL=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,database,nats
NPM_REGISTRY=https://registry.npmjs.org/
